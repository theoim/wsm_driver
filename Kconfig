menu "WIZnet WSM Driver"

#
# Only three things are user-selectable here: the chip, the W6300 QSPI mode,
# and the per-socket buffer sizes. All SPI wiring (pins / host / clock) is
# derived from the chip and hidden from menuconfig -- see the per-chip blocks
# at the bottom. Symbol names are the same for both chips (the port/example
# code reads CONFIG_WSM_DRIVER_PIN_*); only the values differ.
#

config WSM_DRIVER_ENABLED
    bool "Enable wsm_driver"
    default y
    depends on IDF_TARGET_ESP32S3

if WSM_DRIVER_ENABLED

# =============================================================================
# Board selection -- the only hardware choice a user makes
# =============================================================================
# Chip and pins are both derived from the board. Picking the chip alone cannot
# express the wiring, because the W6300 Dev-kit and the W6300 SoM carry the same
# chip on different GPIOs.
choice ESP_WIZ_TOE_BOARD
    prompt "Board"
    default ESP_WIZ_TOE_BOARD_W5500_DEVKIT

config ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    bool "ESP32-W5500-Dev-kit"

config ESP_WIZ_TOE_BOARD_W5500_SOM
    bool "ESP32-W5500-SoM(NEED VERIFY)"

config ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    bool "ESP32-W6300-Dev-kit"

config ESP_WIZ_TOE_BOARD_W6300_SOM
    bool "ESP32-W6300-SoM"

config ESP_WIZ_TOE_BOARD_CUSTOM
    bool "Custom"

endchoice

# =============================================================================
# Chip -- derived from the board, editable only on Custom
# =============================================================================
# A choice member cannot be the target of `select`, so the chip is a plain bool
# whose default follows the board rather than something the board selects.
# The symbol names are unchanged, so no .c source has to know boards exist.
config ESP_WIZ_TOE_CHIP_W6300
    bool "W6300" if ESP_WIZ_TOE_BOARD_CUSTOM
    default y if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default y if ESP_WIZ_TOE_BOARD_W6300_SOM

config ESP_WIZ_TOE_CHIP_W5500
    bool
    default y if !ESP_WIZ_TOE_CHIP_W6300

# =============================================================================
# Network backend selection
# =============================================================================
# TOE and ETH each define wiznet_net_init()/wiznet_net_is_up(), so they are
# mutually exclusive at link time — pick exactly one here.
choice WSM_DRIVER_BACKEND
    prompt "Network backend"
    default WSM_DRIVER_BACKEND_TOE
    help
        TOE = WIZnet hardware TCP/IP via the ioLibrary (W5500 or W6300).
        ETH = the chip as a SPI Ethernet MAC (esp_eth MACRAW) + software LwIP.

config WSM_DRIVER_BACKEND_TOE
    bool "TOE (hardware TCP/IP)"

config WSM_DRIVER_BACKEND_ETH
    bool "esp_eth MACRAW + software LwIP"
    help
        Runs the chip as a dumb Ethernet MAC (MACRAW on hardware socket 0) and
        lets the ESP32-S3's software LwIP own the TCP/IP stack, so the full BSD
        socket API (select/poll, non-blocking, TLS, IPv6, unlimited sockets) is
        available instead of the chip's 8 hardware sockets.

        Each chip has its own esp_eth MAC/PHY pair, selected automatically:
          W5500 -> esp_eth_mac_w5500.c / esp_eth_phy_w5500.c (SPI VDM framing)
          W6300 -> esp_eth_mac_w6300.c / esp_eth_phy_w6300.c (QSPI framing,
                   single or quad per the W6300 QSPI mode option below)

endchoice

# =============================================================================
# W6300 QSPI mode
# =============================================================================
choice WSM_DRIVER_QSPI_MODE
    prompt "W6300 QSPI mode"
    depends on WSM_DRIVER_CHIP_W6300
    default WSM_DRIVER_QSPI_QUAD

config WSM_DRIVER_QSPI_SINGLE
    bool "Single (1-bit, standard SPI wiring)"

config WSM_DRIVER_QSPI_QUAD
    bool "Quad (4-bit, requires IO2/IO3 wiring)"

endchoice

# =============================================================================
# Per-socket buffer sizes (tunable, chip-independent)
# =============================================================================
config WSM_DRIVER_RX_BUF_KB
    int "Per-socket RX buffer size (KB)"
    range 1 16
    default 2

config WSM_DRIVER_TX_BUF_KB
    int "Per-socket TX buffer size (KB)"
    range 1 16
    default 2

# =============================================================================
# BSD socket integration (--wrap): route lwIP sockets to the TOE hardware sockets
# =============================================================================
config WSM_DRIVER_SOCKET_WRAP
    bool 
    depends on WSM_DRIVER_BACKEND_TOE
    default y
    help
        When enabled, lwIP's BSD socket entry points (socket/bind/listen/
        accept/connect/send/recv/close/...) are redirected at link time to the
        WIZnet chip's hardware TCP/IP sockets. Standard socket code then runs
        over the TOE with no source changes.

        This builds the extra TOE port sources (wiznet_toe.c, wiztoe_wrap.c),
        renames ioLibrary's close() to wiz_close() so it no longer hijacks POSIX
        close(), and adds the -Wl,--wrap=lwip_* linker flags.

        Follows the backend choice by default: TOE -> enabled (BSD sockets run
        on the chip), ETH -> not applicable (plain lwIP over esp_eth).

        Turn this OFF for apps that call the ioLibrary socket API directly
        (socket(sn, Sn_MR_TCP, ...) / close(sn)), as the non-loopback examples
        do -- the close() rename above would otherwise send their close(sn) to
        newlib's POSIX close().

# =============================================================================
# SPI wiring -- one definition per symbol, defaults selected by board.
# =============================================================================
# Each symbol is defined exactly once; only its `default` lines are conditional.
# Splitting these into per-board `if` blocks would reintroduce the duplicate
# definitions kconfgen warns about (and plans to raise to an error).
#
# The prompt is gated on Custom, so a fixed board shows read-only derived values
# and only self-designed hardware exposes editable pins. The trailing bare
# `default` covers Custom and follows the chip, so a custom board starts from the
# reference wiring for that chip rather than from nothing.
#
#            MOSI MISO IO2 IO3 SCLK  CS RST INT
#   W5500 Dev-kit  11   13   -   -   12  10   9  14
#   W5500 SoM      11   13   -   -   12  10   9  14
#   W6300 Dev-kit  11   13  14   9   12  10  21   8
#   W6300 SoM      34   35  36  37   42  41  21  33

config ESP_WIZ_TOE_PIN_MOSI         # W6300: D0
    int "MOSI / D0 GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 11 if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 11 if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 11 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 34 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 11

config ESP_WIZ_TOE_PIN_MISO         # W6300: D1
    int "MISO / D1 GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 13 if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 13 if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 13 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 35 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 13

config ESP_WIZ_TOE_PIN_IO2          # W6300: D2 (Quad only)
    int "IO2 / D2 GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    depends on ESP_WIZ_TOE_QSPI_QUAD
    default 14 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 36 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 36

config ESP_WIZ_TOE_PIN_IO3          # W6300: D3 (Quad only)
    int "IO3 / D3 GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    depends on ESP_WIZ_TOE_QSPI_QUAD
    default 9  if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 37 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 37

config ESP_WIZ_TOE_PIN_SCLK
    int "SCLK GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 12 if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 12 if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 12 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 42 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 12

config ESP_WIZ_TOE_PIN_CS
    int "CS GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 10 if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 10 if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 10 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 41 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 10

config ESP_WIZ_TOE_PIN_RST
    int "RST GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 9  if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 9  if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 21 if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 21 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 9

config ESP_WIZ_TOE_PIN_INT
    int "INT GPIO" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 14 if ESP_WIZ_TOE_BOARD_W5500_DEVKIT
    default 14 if ESP_WIZ_TOE_BOARD_W5500_SOM
    default 8  if ESP_WIZ_TOE_BOARD_W6300_DEVKIT
    default 33 if ESP_WIZ_TOE_BOARD_W6300_SOM
    default 14

config ESP_WIZ_TOE_SPI_HOST
    int "SPI host" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 2

config ESP_WIZ_TOE_SPI_CLOCK_HZ
    int "SPI clock (Hz)" if ESP_WIZ_TOE_BOARD_CUSTOM
    default 33000000

endif # ESP_WIZ_TOE_ENABLED

endmenu
